# +Easybuff - MD Systems
# Value Setter panel, embedded in the mod's decision category.
#
# HOI4 has no scripted-GUI text input: editBoxType exists in the engine but is wired
# only to hardcoded systems (chat, unit renaming), and scripted GUIs can bind nothing
# but _click, _click_enabled and _visible. Stepping a staged value with buttons and
# showing it live is the closest equivalent, and is what MD itself does for its own
# central bank rate and tax controls.
guiTypes = {
	containerWindowType = {
		name = "ebmd_input_window"
		position = { x = 0 y = 0 }
		size = { width = 520 height = 414 }

		instantTextBoxType = {
			name = "ebmd_input_title"
			position = { x = 10 y = 6 }
			font = "hoi_18mbs"
			text = ebmd_gui_title
			maxWidth = 500
			format = center
		}

		instantTextBoxType = {
			name = "ebmd_input_readout"
			position = { x = 10 y = 32 }
			font = "hoi_18mbs"
			text = ebmd_gui_readout
			maxWidth = 500
			format = center
		}

