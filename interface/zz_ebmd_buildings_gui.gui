# +Easybuff - MD Systems
# Off-map buildings panel, embedded in its own decision category.
#
# Same interaction as the Value Setter (zz_ebmd_input_gui.gui): HOI4 scripted GUIs have
# no text input, so a per-click count is stepped with buttons and shown live, then each
# building button adds that many off-map.
guiTypes = {
	containerWindowType = {
		name = "ebmd_buildings_window"
		position = { x = 0 y = 0 }
